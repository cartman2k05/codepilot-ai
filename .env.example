# ============================================================
# CodePilot AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Local dev: use the docker-compose postgres service URL below.
# Production: create a free project at https://neon.tech and paste
# the connection string here (postgresql+asyncpg://...).
DATABASE_URL=postgresql+asyncpg://codepilot:codepilot@localhost:5432/codepilot

# ── Groq API ─────────────────────────────────────────────────
# Get a free key at https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# ── Hindsight Cloud (Persistent Memory) ──────────────────────
# Sign up for a free API key at https://hindsight.vectorize.io
# The URL below is the Hindsight Cloud endpoint — no local container needed.
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your-hindsight-api-key-here

# ── JWT Authentication ───────────────────────────────────────
# IMPORTANT: In production, set JWT_SECRET to a strong random value.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── CORS ─────────────────────────────────────────────────────
# Local dev: keep localhost:3000.
# Production: set to your Vercel frontend URL, e.g.:
#   CORS_ORIGINS=["https://codepilot-ai.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend ─────────────────────────────────────────────────
# Local dev: keep localhost:8000.
# Production (Vercel): set this to your Render/Railway backend URL, e.g.:
#   NEXT_PUBLIC_API_URL=https://codepilot-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
