# ============================================================
# CodePilot AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://codepilot:codepilot@postgres:5432/codepilot

# ── Groq API ─────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ── Hindsight ────────────────────────────────────────────────
HINDSIGHT_URL=http://hindsight:8888

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── CascadeFlow (Smart Model Routing) ───────────────────────
CASCADEFLOW_BUDGET=1.0
CASCADEFLOW_MODE=enforce

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
